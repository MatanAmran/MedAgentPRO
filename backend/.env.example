# MedAgentPro - backend/.env, by example (task 5; R-6 and G-SYNTHCAP, chat 21.10, 22:10).
#
# Copy to backend/.env and fill in. backend/.env is gitignored and closed to Code's tools (R9): never commit it, never
# paste it anywhere. python -m tools.preflight --real checks it and prints names only.
#
# Every required value must be set, or the real gateway refuses to start: there is no built-in budget or price.
# The caps per stage follow L10: about 1.4 times the most a model was measured to use, rounded up to 500, set again
# for each model after its first measured round. The values below are the ones approved on 21.10 from Haiku 5.5's
# round of 20.10 (368 calls): rewrite 711, intent 2542, gate 2302, synthesis 2831, redraft 1470 at most.
# C and B (classification, coverage) are not measured yet.
#
# Choose ONE profile and remove the other.

# --- shared -----------------------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...your-key...
MODEL_MAX_OUTPUT_TOKENS=2000
MODEL_MAX_EXCHANGES_PER_MINUTE=10
MODEL_MAX_OUTPUT_TOKENS_REWRITE=1200
MODEL_MAX_OUTPUT_TOKENS_INTENT=3000
MODEL_MAX_OUTPUT_TOKENS_GATE=3000
MODEL_MAX_OUTPUT_TOKENS_SYNTHESIS=4000
MODEL_MAX_OUTPUT_TOKENS_CLASSIFY=1000
MODEL_MAX_OUTPUT_TOKENS_COVERAGE=1500
# MODEL_TEMPERATURE is left unset: Claude 5 models take no sampling parameter (R1)
# The prompt cache, only for back-to-back evaluation rounds (task 7, T1):
# MODEL_PROMPT_CACHE=1

# --- profile 1: Haiku 5.5, development rounds (chat 19.10) -----------------------------------------------------
MODEL_ID=claude-haiku-5-5
MODEL_PRICE_IN=0.10
MODEL_PRICE_OUT=0.50
MODEL_MAX_USD_PER_EXCHANGE=0.05
# at least 10 exchanges each spending its whole cap (T12), and below the credit left in the Console
MODEL_BUDGET_USD=0.5

# --- profile 2: Sonnet 5.5, the last round before a merge (chat 19.10) ------------------------------------------
# MODEL_ID=claude-sonnet-5-5
# MODEL_PRICE_IN=2
# MODEL_PRICE_OUT=10
# 0.35, not 0.25: with synthesis at 4000 the worst path needs about 0.29 (G-SYNTHCAP, closed 21.10, 22:10)
# MODEL_MAX_USD_PER_EXCHANGE=0.35
# 10 worst-case exchanges (T12), and below the credit left in the Console
# MODEL_BUDGET_USD=3.5
