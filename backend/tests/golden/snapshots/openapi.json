    "parameters": [
     {
      "in": "query",
      "name": "archived",
      "required": false,
      "schema": {
       "default": false,
       "title": "Archived",
       "type": "boolean"
      }
     },
     {
      "in": "header",
      "name": "x-demo-user",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "X-Demo-User"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
     },
     "422": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      },
      "description": "Validation Error"
     }
    },
    "summary": "List Conversations"
   },
