{
 "components": {
  "schemas": {
   "AskBody": {
    "properties": {
     "question": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
     },
     "request_id": {
      "maxLength": 100,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Request Id",
      "type": "string"
     }
    },
    "required": [
     "question",
     "request_id"
    ],
    "title": "AskBody",
    "type": "object"
   },
   "ConversationChange": {
    "additionalProperties": false,
    "description": "UI refresh, phase B [demo extension]. At least one field; nothing else is accepted.",
    "properties": {
     "archived": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "Archived"
     },
     "pinned": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "Pinned"
     },
     "title": {
      "anyOf": [
       {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Title"
     }
    },
    "title": "ConversationChange",
    "type": "object"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "title": "Detail",
      "type": "array"
     }
    },
    "title": "HTTPValidationError",
    "type": "object"
   },
   "RatingBody": {
    "properties": {
     "rating": {
      "pattern": "^(up|down)$",
      "title": "Rating",
      "type": "string"
     }
    },
    "required": [
     "rating"
    ],
    "title": "RatingBody",
    "type": "object"
   },
   "ValidationError": {
    "properties": {
     "ctx": {
      "title": "Context",
      "type": "object"
     },
     "input": {
      "title": "Input"
     },
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "title": "Location",
      "type": "array"
     },
     "msg": {
      "title": "Message",
      "type": "string"
     },
     "type": {
      "title": "Error Type",
      "type": "string"
     }
    },
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError",
    "type": "object"
   }
  }
 },
 "info": {
  "title": "MedAgentPro chat (demo)",
