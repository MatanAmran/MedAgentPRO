                      {
                        "value": 1
                      },
                      {
                        "value": 13
                      }
                    ]
                  },
                  {
                    "EQ": [
                      {
                        "metric": "late_by_delivery"
                      },
                      {
                        "value": true
                      }
                    ]
                  }
                ]
              },
              "GROUP_BY": [
                "supplier_id"
              ],
              "ORDER_BY": [
                {
                  "by": "late_count",
                  "dir": "DESC"
                }
              ],
              "LIMIT": 10
            }
          },
          {
            "label": "late_by_promise",
